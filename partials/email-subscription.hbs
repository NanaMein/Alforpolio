<form class="gh-form ap-form" data-members-form>
    <input class="gh-form-input ap-form-input" id="{{email_field_id}}" name="email" type="email" placeholder="{{t "alfycodes@example.com"}}" required data-members-email>
    <button class="gh-button ap-form-button" type="submit" aria-label="{{t "Subscribe"}}">
        <span><span>{{t "Subscribe"}}</span> {{> "icons/arrow"}}</span>
        {{> "icons/loader"}}
        <span>{{t "Email sent"}}</span>
    </button>
    <p class="ap-form-error" data-members-error></p>
</form>
